{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.apparatuscertified.tech/api/:path*" },
    { "source": "/iiif/:path*", "destination": "https://api.apparatuscertified.tech/iiif/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
