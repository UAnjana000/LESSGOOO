# deploy/production/.env - site settings read by compose.yaml. Copy this file to .env and edit it.
# NON-SECRET values only; .env is git-ignored because it is site-specific. Passwords and API keys are
# Docker secrets: one file each in SECRETS_DIR (docs/ops/secrets.md). Never paste a key into this file.
# This is not the repository-root .env, which configures the local demo only.

# Image tag built for this release (docker compose build tags ambedkar-archive/api and /web with it).
RELEASE_TAG=2026.09.1

# ---- Sites and access boundary --------------------------------------------------------------------------
# One hostname per site, resolvable on its own network, matching the certificate SAN.
VISITOR_SITE=archive.gallery.example.org
STAFF_SITE=staff.archive.example.org

# Host interfaces. Visitor listener on the gallery-network NIC, staff listener on the staff-network NIC.
# With a single NIC, use the same IP for both and scope the staff port with Windows Firewall (docs/ops).
VISITOR_BIND_IP=10.10.10.5
STAFF_BIND_IP=10.20.20.5
VISITOR_HTTP_PORT=80
VISITOR_HTTPS_PORT=443
STAFF_HTTPS_PORT=8443

# Extra source-IP allowlist on the staff site. Leave as private_ranges until you have confirmed in the
# proxy access log that "remote_ip" shows real client addresses (Docker Desktop NAT often hides them).
STAFF_ALLOWED_CIDRS=private_ranges
STAFF_MAX_UPLOAD=2GB

# ---- HTTPS ----------------------------------------------------------------------------------------------
# Arguments for Caddy's tls directive. Default: PEM files placed in CERTS_PATH (mounted at /certs).
CERTS_PATH=./certs
VISITOR_TLS=/certs/visitor.crt /certs/visitor.key
STAFF_TLS=/certs/staff.crt /certs/staff.key

# ---- Secrets location -----------------------------------------------------------------------------------
# Folder holding one file per Docker secret: postgres_password, jwt_secret, bootstrap_admin_password,
# sarvam_api_key, llm_api_key, langfuse_secret_key. Keep it outside the repository on a real server.
SECRETS_DIR=./secrets

# ---- Application (non-secret, names from backend/archive/config.py) -------------------------------------
# Base URL printed in QR take-away links. Visitors' phones must be able to reach it.
ARCHIVE_PUBLIC_BASE_URL=https://archive.gallery.example.org
# JSON list. Same-origin through the proxy, so this only replaces the dev default (localhost:5173).
ARCHIVE_CORS_ORIGINS=["https://archive.gallery.example.org","https://staff.archive.example.org:8443"]
ARCHIVE_LOG_LEVEL=INFO

# First administrator account; its password is the bootstrap_admin_password secret.
ARCHIVE_BOOTSTRAP_ADMIN_EMAIL=archive-admin@example.org
ARCHIVE_JWT_TTL_MINUTES=480

# Answer model. "none" = Ask returns labelled extractive passages. For "openai_compatible", set the
# provider's endpoint and model id here and put the key in the llm_api_key secret. Record the provider's
# data-location and retention terms before go-live (spec 6.2).
ARCHIVE_LLM_PROVIDER=none
ARCHIVE_LLM_BASE_URL=
ARCHIVE_LLM_MODEL=
ARCHIVE_LLM_INPUT_COST_PER_MTOK=0
ARCHIVE_LLM_OUTPUT_COST_PER_MTOK=0
ARCHIVE_DAILY_COST_ALERT_USD=5
# Sarvam (OCR fallback, translation, TTS) is enabled by a non-empty sarvam_api_key secret.

# Langfuse on a separate machine (spec 6.6). Empty = redacted JSONL traces in the traces volume.
# The secret key is the langfuse_secret_key secret.
ARCHIVE_LANGFUSE_PUBLIC_KEY=
ARCHIVE_LANGFUSE_HOST=
ARCHIVE_TRACE_QUESTION_MODE=scrubbed

# Kiosk exhibit cache lease and QR link lifetime (institution policy, spec 4.7 / 5.4).
ARCHIVE_EXHIBIT_LEASE_HOURS=72
ARCHIVE_QR_LINK_TTL_HOURS=24

# ---- Storage (Windows paths use forward slashes) --------------------------------------------------------
# Preservation masters: a dedicated disk or volume, NOT the system drive and NOT the backup disk.
# Must contain the marker file .archive-preservation-volume (see docs/ops/startup-and-migrations.md).
PRESERVATION_PATH=P:/archive/preservation
# Backup target: a different physical disk from PRESERVATION_PATH. Off-site copy is made from here.
BACKUP_PATH=B:/archive-backups
# Empty working area for restores and restore drills (can be on the backup disk).
RESTORE_STAGING_PATH=B:/archive-restore-staging
# Folder where the digitisation station drops capture batches + manifests (read-only to the ops container).
INTAKE_PATH=D:/capture-intake

# ---- Capacity (set from the spec 3.4 benchmark, not guessed) --------------------------------------------
API_CPUS=4
API_MEM=4g
WORKER_CPUS=2
WORKER_MEM=3g
DB_MEM=4g
LOG_MAX_SIZE=20m
LOG_MAX_FILE=10
