# Throwaway image for the OCR engine comparison (docs/OCR_ENGINE_EVAL.md). Not part of the stack.
#   docker build -f eval/ocr_engine/Dockerfile.bench -t ambedkar-archive/ocr-eval:bench eval/ocr_engine
FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir paddlepaddle==3.3.1 paddleocr==3.7.0 opencv-python-headless numpy pillow psutil
RUN python -c "from paddleocr import PaddleOCR; \
[PaddleOCR(text_detection_model_name='PP-OCRv5_mobile_det', text_recognition_model_name=r, \
 use_doc_orientation_classify=False, use_doc_unwarping=False, use_textline_orientation=False, device='cpu') \
 for r in ('en_PP-OCRv5_mobile_rec', 'devanagari_PP-OCRv5_mobile_rec')]; print('paddle models cached')"
RUN pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir easyocr==1.7.2
RUN python -c "import easyocr; easyocr.Reader(['hi','en'], gpu=False); easyocr.Reader(['en'], gpu=False); print('easyocr models cached')"
