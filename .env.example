# Copy to .env for the LOCAL DEMO. Never commit .env. Production uses Docker secrets (deploy/production).

# Database
POSTGRES_PASSWORD=change-me-local-db-password

# Staff auth (prototype: password + JWT; production: SSO/MFA - see docs/DEPLOYMENT.md)
ARCHIVE_JWT_SECRET=change-me-at-least-32-random-characters
ARCHIVE_BOOTSTRAP_ADMIN_EMAIL=admin@archive.local
ARCHIVE_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
# Local demo only: creates archivist@demo.local, curator@demo.local, reviewer-hi@demo.local, reviewer-mr@demo.local
ARCHIVE_DEMO_STAFF_PASSWORD=change-me-demo-password
# Demo only: "true" adds "Continue as judge (read-only)" to the staff sign-in page. It signs in
# judge@demo.local without a password; that account can open every staff page and change nothing.
ARCHIVE_JUDGE_ACCESS=false

# Local OCR (Tesseract). api:local defaults are Debian eng/hin/mar and PSM 3.
# The evaluated Hindi route (tessdata_best Devanagari + PSM auto) is the separate
# image ambedkar-archive/api:ocr-deva — see docs/OCR_ENGINE_EVAL.md. Do not rebuild api:local.
# ARCHIVE_OCR_TESSERACT_PSM=auto
# ARCHIVE_OCR_TESSERACT_LANG_HI=Devanagari

# Sarvam AI (OCR fallback, translation, TTS). Empty = disabled: failed-gate pages stay pending review,
# on-demand translation shows "needs connection", narration uses offline espeak-ng.
ARCHIVE_SARVAM_API_KEY=

# Answer model (OpenAI-compatible /chat/completions). "none" = Ask returns labelled extractive passages.
ARCHIVE_LLM_PROVIDER=none
ARCHIVE_LLM_BASE_URL=https://api.openai.com/v1
ARCHIVE_LLM_API_KEY=
ARCHIVE_LLM_MODEL=
# USD per 1M tokens, used for the logged answer cost and the daily cost alert. 0 logs every answer as $0
# (the API warns at startup). Shown: gpt-4o-mini list prices - check current pricing for your model.
ARCHIVE_LLM_INPUT_COST_PER_MTOK=0.15
ARCHIVE_LLM_OUTPUT_COST_PER_MTOK=0.60

# Langfuse (redacted traces only). Empty = local redacted JSONL sink in the traces volume.
ARCHIVE_LANGFUSE_PUBLIC_KEY=
ARCHIVE_LANGFUSE_SECRET_KEY=
ARCHIVE_LANGFUSE_HOST=

# Reverse proxy: "localhost" uses Caddy's internal CA (browser warning). A real domain gets a public certificate.
SITE_ADDRESS=localhost
ARCHIVE_PUBLIC_BASE_URL=https://localhost:8443
# Host ports for the proxy. The compose default HTTP port is 8080; on the demo machine 8080 is already taken,
# so set HTTP_PORT=8088 (here or in the shell) or `docker compose up proxy` fails with "bind 0.0.0.0:8080".
HTTP_PORT=8088
HTTPS_PORT=8443
